NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://task:task@localhost:5432/task_api?schema=public
SHADOW_DATABASE_URL=postgresql://task:task@localhost:5432/task_api_shadow?schema=public

REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_SECRET=change-me-32-bytes-minimum-random-secret
JWT_REFRESH_SECRET=change-me-32-bytes-minimum-random-different
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

COOKIE_SECURE=false
COOKIE_DOMAIN=

BCRYPT_COST=12
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_USER_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=10

SOFT_DELETE_RETENTION_DAYS=30
MAX_ASSIGNEES_PER_TASK=10
MAX_SUBTASK_DEPTH=3

ENABLE_SWAGGER=true
